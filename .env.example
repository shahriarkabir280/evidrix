# Copy to .env and adjust. New settings are added here as each component needs them.
APP_ENV=development
LOG_JSON=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/evidrix
MAX_UPLOAD_BYTES=10000000
BLOB_DIR=data/uploads
REDIS_URL=redis://localhost:6379/0
# Deployment: postgres keeps uploads in the database; inline runs ingestion in the API process;
# CHAT_ENABLED=false for a retrieval-only deployment without an LLM. See docs/deploy.md.
BLOB_BACKEND=local
INGESTION_MODE=rq
CHAT_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=auto
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-vl:8b-instruct
LLM_CONTEXT_TOKENS=8192
# A hosted model instead of Ollama, e.g. a free one on OpenRouter (key: openrouter.ai/keys).
# Your documents' text is sent to that provider. See README, "Using a hosted model".
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_CONTEXT_TOKENS=32768
# LLM_RESPONSE_FORMAT=json_schema   # json_object for models with JSON mode only
# LLM_MAX_OUTPUT_TOKENS=2048        # reasoning models spend tokens thinking first
